#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; i++) cin >> a[i];
    
    int maxLen = 1, len = 1;
    for (int i = 1; i < n; i++) {
        if (a[i] >= a[i-1]) len++;
        else len = 1;
        maxLen = max(maxLen, len);
    }
    cout << maxLen;
}
