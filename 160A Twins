#include <bits/stdc++.h>
using namespace std;

int main() {
 int n;
    cin >> n;
    vector<int> a(n);
    long long total = 0;
    for(int i = 0; i < n; i++) {
        cin >> a[i];
        total += a[i];
    }

    sort(a.rbegin(), a.rend());
    long long sum = 0;
    int cnt = 0;
    for(int i = 0; i < n; i++) {
        sum += a[i];
        cnt++;
        if(sum > total - sum) break;
    }
    cout << cnt;
}
