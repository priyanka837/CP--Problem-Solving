#include <bits/stdc++.h>
using namespace std;

int main() {
    
    cin.tie(nullptr);

    string n;
    cin >> n;
    int cnt = 0;
    for(char c : n)
        if(c == '4' || c == '7') cnt++;

    string s = to_string(cnt);
    bool nearly = true;
    for(char c : s)
        if(c != '4' && c != '7') nearly = false;

    cout << (nearly ? "YES" : "NO");
}
